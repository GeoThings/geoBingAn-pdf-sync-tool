# geoBingAn PDF Sync Tool 環境變數設定
# 複製此檔案為 .env 並填入實際值
# cp .env.example .env

# ============================================
# Google Drive 設定
# ============================================
GOOGLE_CREDENTIALS=./credentials.json
SHARED_DRIVE_ID=your-shared-drive-id

# ============================================
# geoBingAn API 認證
# ============================================
JWT_TOKEN=your-jwt-token
REFRESH_TOKEN=your-refresh-token
USER_EMAIL=your-email@example.com
USER_ID=your-user-id
GROUP_ID=your-group-id
GROUP_NAME=your-group-name

# ============================================
# API 端點
# ============================================
GEOBINGAN_BASE_URL=https://riskmap.today
GEOBINGAN_API_URL=https://riskmap.today/api/reports/construction-reports/upload/
GEOBINGAN_REFRESH_URL=https://riskmap.today/api/auth/auth/refresh_token/

# ============================================
# 通知設定 (可選)
# ============================================
# LINE Notify Token (從 https://notify-bot.line.me/ 取得)
LINE_NOTIFY_TOKEN=

# 啟用 macOS 通知 (true/false)
ENABLE_MACOS_NOTIFY=true

# health_check --notify 的 ClickUp task ID
# 設定後，healthcheck 異常會發到該 task comment（macOS 睡眠時也收得到）
# 留空則只走 macOS / LINE 通知
HEALTHCHECK_CLICKUP_TASK_ID=
# error 級告警要 @ 的 ClickUp user id（被 @ 才會收到推播；留空=不 @）
# Email 告警（error 級；實測唯一會推播到手機的通道）
# ⚠️ ClickUp 的 @ 對 token 擁有者本人無效——ClickUp 不通知自己發的留言
# 密碼＝Google 帳號的「應用程式密碼」（個人帳號設定，非組織管理權限）
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=                     # 留空則同 ALERT_EMAIL_TO
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465
ALERT_SMTP_PASSWORD=                  # 16 碼應用程式密碼（勿提交）

ALERT_MENTION_USER_ID=

# ============================================
# 同步設定
# ============================================
# 單次最多上傳數量 (程式碼內 MAX_UPLOADS，預設 100)
# 上傳間隔 0.5 秒（程式碼內 DELAY_BETWEEN_UPLOADS，不可透過環境變數調整）

# 解析預算守門（後端解析受 OpenAI 花費上限節制；單筆估算成本 / 月上限 / 單次需 --yes 的門檻）
# 本月計數存 state/upload_budget.json（本機狀態、不入版控）。換機或重建時請先初始化：
#   python -m geobingan_sync.budget --show      # 查看
#   python -m geobingan_sync.budget --set N     # 設定本月已傳份數
MAX_UPLOADS=15   # 夜間每日上傳上限（穩態約 6 份/日；0=不限，有打爆後端預算風險）
COST_PER_REPORT_USD=0.3
MONTHLY_BUDGET_USD=100
BUDGET_CONFIRM_USD=15
